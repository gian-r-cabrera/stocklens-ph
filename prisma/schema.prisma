// StockLens PH market data — mirrors db/migrations/001_market_tables.sql
// Connection URLs: prisma.config.ts (Prisma 7)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model MarketQuoteLatest {
  symbol    String   @id
  lastClose Decimal  @map("last_close") @db.Decimal(18, 6)
  changePct Decimal  @default(0) @map("change_pct") @db.Decimal(10, 4)
  changeAbs Decimal? @map("change_abs") @db.Decimal(18, 6)
  volume    BigInt?
  asOf      DateTime @default(now()) @map("as_of") @db.Timestamptz(6)
  source    String   @default("dss")

  @@index([asOf(sort: Desc)], map: "market_quotes_latest_as_of_idx")
  @@map("market_quotes_latest")
}

model MarketBarDaily {
  symbol    String
  tradeDate DateTime @map("trade_date") @db.Date
  open      Decimal  @db.Decimal(18, 6)
  high      Decimal  @db.Decimal(18, 6)
  low       Decimal  @db.Decimal(18, 6)
  close     Decimal  @db.Decimal(18, 6)
  volume    BigInt?

  @@id([symbol, tradeDate])
  @@index([symbol, tradeDate(sort: Desc)], map: "market_bars_daily_symbol_date_idx")
  @@map("market_bars_daily")
}

model MarketForecastLatest {
  symbol      String
  model       String
  horizonDays Int      @map("horizon_days")
  generatedAt DateTime @map("generated_at") @db.Timestamptz(6)
  points      Json

  @@id([symbol, model, horizonDays])
  @@map("market_forecasts_latest")
}

model MarketModelMetrics {
  symbol      String
  model       String
  horizonDays Int      @map("horizon_days")
  mae         Decimal  @db.Decimal(18, 6)
  rmse        Decimal  @db.Decimal(18, 6)
  mape        Decimal  @db.Decimal(10, 4)
  dirAccuracy Decimal? @map("dir_accuracy") @db.Decimal(10, 4)
  computedAt  DateTime @map("computed_at") @db.Timestamptz(6)

  @@id([symbol, model, horizonDays])
  @@map("market_model_metrics")
}

// Company-size/liquidity reference stats from PSE EDGE's stockdataList
// endpoint — not P/E-style fundamentals (no EPS/revenue/dividend data;
// that needs disclosure-PDF parsing, a separate unbuilt project).
model CompanyStatsLatest {
  symbol                   String   @id
  marketCap                Decimal? @map("market_cap") @db.Decimal(20, 2)
  outstandingShares        Decimal? @map("outstanding_shares") @db.Decimal(20, 2)
  freeFloatPct             Decimal? @map("free_float_pct") @db.Decimal(10, 4)
  foreignOwnershipLimitPct Decimal? @map("foreign_ownership_limit_pct") @db.Decimal(10, 4)
  parValue                 Decimal? @map("par_value") @db.Decimal(18, 6)
  asOf                     DateTime @default(now()) @map("as_of") @db.Timestamptz(6)

  @@map("company_stats_latest")
}

// Real per-filing fundamentals, parsed from the latest SEC Form 17-Q
// quarterly-report cover sheet PSE EDGE renders as structured HTML — not
// PDF-extracted. See scripts/market/pse-edge-fundamentals.ts.
model FundamentalsLatest {
  symbol              String    @id
  periodEnded         DateTime  @map("period_ended") @db.Date
  totalAssets         Decimal?  @map("total_assets") @db.Decimal(24, 2)
  totalLiabilities    Decimal?  @map("total_liabilities") @db.Decimal(24, 2)
  stockholdersEquity  Decimal?  @map("stockholders_equity") @db.Decimal(24, 2)
  bookValuePerShare   Decimal?  @map("book_value_per_share") @db.Decimal(18, 6)
  grossRevenueYtd     Decimal?  @map("gross_revenue_ytd") @db.Decimal(24, 2)
  netIncomeYtd        Decimal?  @map("net_income_ytd") @db.Decimal(24, 2)
  epsBasicTtm         Decimal?  @map("eps_basic_ttm") @db.Decimal(18, 6)
  epsDilutedTtm       Decimal?  @map("eps_diluted_ttm") @db.Decimal(18, 6)
  dividendPerShareTtm Decimal?  @map("dividend_per_share_ttm") @db.Decimal(18, 6)
  asOf                DateTime  @default(now()) @map("as_of") @db.Timestamptz(6)

  @@map("fundamentals_latest")
}

// Backs API rate limiting (lib/api/rate-limit.ts). Previously in-memory,
// which doesn't hold up on Vercel's serverless Node runtime — a fresh
// cold-started instance gets its own empty Map, so the limit only ever
// applied within a single warm instance's lifetime.
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime @map("reset_at") @db.Timestamptz(6)

  @@map("rate_limits")
}
