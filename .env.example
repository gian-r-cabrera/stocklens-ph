# Copy to .env (Prisma CLI) and .env.local (Next.js dev).
# Never commit real credentials.
# Optional: .env.ingest for DSS cron (writer DATABASE_URL) — gitignored

# --- Vercel / CI preview ---
# MARKET_DATA_SOURCE=static
# (no DATABASE_URL; uses data/market-quotes-snapshot.json)

# --- DSS production app (readonly pooler) ---
# MARKET_DATA_SOURCE=db
# DATABASE_URL="postgresql://stocklens_readonly:PASSWORD@HOST.pooler.supabase.com:6543/postgres?pgbouncer=true"

# --- Local default (pick one mode in .env.local) ---
MARKET_DATA_SOURCE=static

# Supabase pooler — app + ingest (copy full host from dashboard, e.g. aws-1-ap-southeast-1)
# Wrong: ap-southeast-1.pooler.supabase.com (region slug only → ENOTFOUND)
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection — Prisma Migrate only (port 5432, Session or db.*.supabase.co)
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Forecasts snapshot storage (Supabase Storage, bucket "market-data", public-read)
# SUPABASE_URL needed to read it, in every mode. SUPABASE_SERVICE_ROLE_KEY is only
# needed to publish it — ingest-only, never in the deployed app's runtime env.
SUPABASE_URL="https://PROJECT_REF.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="PASTE_FROM_SUPABASE_DASHBOARD_SETTINGS_API"

# --- Access gate (optional) — leave both unset to disable the login screen ---
# Shared password for the login screen (src/app/login). Single-user gate,
# not per-account auth — anyone with the password gets in.
# APP_PASSWORD="choose-a-password"
# Random string used to sign the session cookie (HMAC-SHA256). Rotate this
# to invalidate all existing sessions without changing APP_PASSWORD.
# AUTH_SECRET="generate-a-long-random-string"

# --- Error monitoring (optional) — see docs/OBSERVABILITY.md ---
# Sentry no-ops when these are unset; safe to leave commented out.
# NEXT_PUBLIC_SENTRY_DSN="https://KEY@oORG_ID.ingest.REGION.sentry.io/PROJECT_ID"
# SENTRY_DSN="https://KEY@oORG_ID.ingest.REGION.sentry.io/PROJECT_ID"
# Only needed for readable stack traces (source map upload at build time):
# SENTRY_ORG="your-org-slug"
# SENTRY_PROJECT="your-project-slug"
# SENTRY_AUTH_TOKEN="PASTE_FROM_SENTRY_SETTINGS_AUTH_TOKENS"
